{
  "description": "Shared cases for effective(): live.py (Python) and Merge.swift must both pass them. 'hook' uses the session file's schema-2 field names; 'live' uses the field names of `claude agents --json`.",
  "constants": {
    "FRESH_MARGIN": 2.0,
    "SNAPSHOT_MAX_AGE": 15.0,
    "ABSENT_GRACE": 90.0,
    "BACKGROUND_DECAY": 1800.0,
    "IDLE_HIDE_AFTER": 14400.0,
    "LEGACY_ACTIVE_HIDE": 3600.0
  },
  "cases": [
    {
