      "now": 100000.0, "observed_at": null,
      "hook": {"base_status": "THINKING", "pending": {}, "status_ts": 99990.0, "activity_ts": 99995.0},
      "live": null,
      "expect": {"status": "THINKING", "detail": null, "hidden": false, "legacy": true, "untracked": false, "stale_idle": false}
    },
    {
